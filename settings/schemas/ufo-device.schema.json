{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "ufo-device",
  "version": "1.0.0",
  "displayName": "UFO device",
  "description": "A physical Dynatrace UFO reachable on your network. Managed by the UFO Studio app.",
  "maturity": "IN_DEVELOPMENT",
  "multiObject": true,
  "maxObjects": 100,
  "ordered": false,
  "ownerBasedAccessControl": false,
  "summaryPattern": "{displayName} ({protocol}://{host})",
  "enums": {
    "protocol": {
      "type": "enum",
      "displayName": "Protocol",
      "description": "Network scheme used to reach the device.",
      "items": [
        { "value": "http", "displayName": "HTTP" },
        { "value": "https", "displayName": "HTTPS" }
      ]
    }
  },
  "properties": {
    "displayName": {
      "displayName": "Display name",
      "description": "Human-friendly name for this UFO.",
      "type": "text",
      "nullable": false,
      "default": "",
      "constraints": [{ "type": "LENGTH", "maxLength": 200 }]
    },
    "host": {
      "displayName": "Host",
      "description": "Bare hostname or IP address of the UFO, with no scheme and no path (e.g. 192.168.1.42 or ufo.local).",
      "type": "text",
      "nullable": false,
      "default": "",
      "constraints": [{ "type": "LENGTH", "maxLength": 255 }]
    },
    "protocol": {
      "displayName": "Protocol",
      "description": "Scheme used to reach the device. Use HTTPS only if the device serves TLS.",
      "type": { "$ref": "#/enums/protocol" },
      "nullable": false,
      "default": "http"
    },
    "port": {
      "displayName": "Port",
      "description": "Optional TCP port. Leave empty to use the protocol default (80 for HTTP, 443 for HTTPS).",
      "type": "integer",
      "nullable": true,
      "constraints": [{ "type": "RANGE", "minimum": 1, "maximum": 65535 }]
    },
    "enabled": {
      "displayName": "Enabled",
      "description": "Disabled devices are shown but never receive renders.",
      "type": "boolean",
      "nullable": false,
      "default": true
    },
    "organization": {
      "displayName": "Organization",
      "description": "Optional grouping tag, e.g. the owning organization.",
      "type": "text",
      "nullable": true,
      "constraints": [{ "type": "LENGTH", "maxLength": 200 }]
    },
    "department": {
      "displayName": "Department",
      "description": "Optional grouping tag, e.g. the owning department or team.",
      "type": "text",
      "nullable": true,
      "constraints": [{ "type": "LENGTH", "maxLength": 200 }]
    },
    "location": {
      "displayName": "Location",
      "description": "Optional physical location of the device, e.g. a floor or room.",
      "type": "text",
      "nullable": true,
      "constraints": [{ "type": "LENGTH", "maxLength": 200 }]
    },
    "deviceId": {
      "displayName": "Device ID",
      "description": "Stable identifier generated by the app. Do not edit.",
      "type": "text",
      "nullable": false,
      "default": "",
      "constraints": [{ "type": "LENGTH", "maxLength": 100 }]
    }
  }
}
