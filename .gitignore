# DT APP files
.dt-app/*
!/.dt-app/deployment.json

# Compiled output
/dist
/build
/tmp

# Deployment artifact
/out

# Dependencies
/node_modules

# IDEs and editors
/.idea
*.iml
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# IDE - VSCode
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/extensions.json

# System Files
.DS_Store
Thumbs.db

# app-settings plugin local files
/settings/local-mock-data/secrets.json
/settings/local-mock-data/persistence/

# EdgeConnect credentials (contains an OAuth client secret) — never commit
/edgeConnect.yaml
/edgeConnect*.yaml

# Environment / secret files — never commit (keep a safe .env.example template)
.env
.env.*
!.env.example

# Test coverage output
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
