    "eslint-plugin-security": "^4.0.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "jest": "^30.5.1",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.12",
    "jest-environment-jsdom": "^30.5.1",
    "@testing-library/react": "^16.3.3",
