    "create:action": "dt-app action create",
    "uninstall": "dt-app uninstall",
    "deploy": "dt-app deploy",
    "update": "dt-app update",
    "info": "dt-app info",
    "help": "dt-app help",
    "lint": "eslint .",
    "test:actions": "jest --config=actions/jest.action.config.js",
    "test:widgets": "jest --config=actions/jest.widget.config.js",
    "test:lib": "jest --config=lib/jest.lib.config.js",
    "typecheck:lib": "tsc --noEmit -p lib/tsconfig.lib.json"
  },
  "engines": {
    "node": ">=16.13.0"
  },
  "author": "garciaba",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garciaba/ufo-studio.git"
  },
  "bugs": {
    "url": "https://github.com/garciaba/ufo-studio/issues"
  },
  "homepage": "https://github.com/garciaba/ufo-studio#readme",
