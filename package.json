  "devDependencies": {
    "dt-app": "1.16.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "eslint": "^10.10.0",
