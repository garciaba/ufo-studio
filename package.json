    "@dynatrace/automation-action-components": "^5.1.2",
    "@dynatrace/strato-components": "^3.11.1",
    "@dynatrace/strato-components-preview": "^3.4.1",
    "@dynatrace/strato-design-tokens": "^1.6.0",
    "@dynatrace/strato-icons": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
